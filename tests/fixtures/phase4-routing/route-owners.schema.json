{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CPAMP Phase4-01 route ownership contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "contractId",
    "fixedBootstrapDiscoveryPath",
    "canonicalPublicApiV2Suffix",
    "publicApiActivation",
    "snapshotStates",
    "routes",
    "normalization",
    "retiredNamespace"
  ],
  "properties": {
    "$schema": {"const": "./route-owners.schema.json"},
    "schemaVersion": {"const": 1},
    "contractId": {"const": "cpamp-v2-phase4-01-routing-ownership-v1"},
    "fixedBootstrapDiscoveryPath": {"const": "/.well-known/cpamp-bootstrap"},
    "canonicalPublicApiV2Suffix": {"const": "/api/v2"},
    "publicApiActivation": {"const": "verified_effective_snapshot_only"},
    "snapshotStates": {
      "type": "array",
      "const": ["verified_effective", "desired_only", "stale", "unknown", "unavailable"]
    },
    "routes": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "match", "owner", "gatewayFallback"],
        "properties": {
          "id": {"type": "string"},
          "match": {"type": "string"},
          "owner": {"enum": ["manager", "gateway"]},
          "activeMethods": {"type": "array", "items": {"type": "string"}},
          "unsupportedMethods": {"type": "string"},
          "completedBehavior": {"type": "string"},
          "authority": {"type": "string"},
          "noAuthorityBehavior": {"type": "string"},
          "behavior": {"type": "string"},
          "reuseBehavior": {"type": "string"},
          "compatibility": {"type": "string"},
          "credentialHeaders": {"type": "string"},
          "gatewayFallback": {"enum": ["deny", "preserve"]}
        }
      }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptedRequestPath", "reject", "credentialRouting"],
      "properties": {
        "acceptedRequestPath": {"const": "decoded_canonical_path_only"},
        "reject": {"type": "array", "minItems": 9, "items": {"type": "string"}},
        "credentialRouting": {"const": "route_ownership_precedes_credentials"}
      }
    },
    "retiredNamespace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["persistence", "history", "managerCredentials", "modelTraffic"],
      "properties": {
        "persistence": {"const": "none_in_phase4_01"},
        "history": {"const": "bounded_representation_only"},
        "managerCredentials": {"const": "never_forward"},
        "modelTraffic": {"const": "never_forward"}
      }
    }
  }
}
