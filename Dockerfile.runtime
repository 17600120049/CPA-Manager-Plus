FROM --platform=$BUILDPLATFORM alpine:3.21 AS cpa-download

ARG TARGETOS
ARG TARGETARCH
RUN set -eu; \
    test "$TARGETOS" = "linux"; \
    cpa_version="7.3.3"; \
    case "$TARGETARCH" in \
      amd64) asset_arch="amd64"; asset_sha256="7af8c99cd08eee3ccc81d1596e8a31785674d3de6bd7ec61416d59493dd8fc01" ;; \
      arm64) asset_arch="aarch64"; asset_sha256="5f320e3fae52af00f07b78201311e9d096b36e759441d948de48a10f49e71883" ;; \
      *) echo "unsupported CPA target architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    asset_name="CLIProxyAPI_${cpa_version}_linux_${asset_arch}.tar.gz"; \
    apk add --no-cache ca-certificates wget; \
    wget -qO "/tmp/${asset_name}" "https://github.com/router-for-me/CLIProxyAPI/releases/download/v${cpa_version}/${asset_name}"; \
    printf '%s  %s\n' "$asset_sha256" "/tmp/${asset_name}" | sha256sum -c -; \
    mkdir -p /out; \
    tar -xOzf "/tmp/${asset_name}" cli-proxy-api > /out/cli-proxy-api; \
    chmod 0755 /out/cli-proxy-api; \
    binary_sha256="$(sha256sum /out/cli-proxy-api | awk '{print $1}')"; \
    printf '{"schemaVersion":1,"engine":"cpa","version":"%s","artifactId":"sha256:%s"}\n' \
      "$cpa_version" "$binary_sha256" > /out/cpa-artifact.json; \
    chmod 0444 /out/cpa-artifact.json

# Official v8 pin shared by the default bundle and private amd64 proofs.
# No version/hash override is accepted for this pin.
FROM --platform=$BUILDPLATFORM alpine:3.21 AS cpa-v8-download

ARG TARGETOS
ARG TARGETARCH
RUN set -eu; \
    test "$TARGETOS" = "linux"; \
    case "$TARGETARCH" in \
      amd64) asset_arch="amd64"; \
        archive_sha256="e9e3a33a489d8a94ea9bd4b8eb4bb9286a978c3df11dc4c49f5ef393ef0fdc68"; \
        executable_sha256="343084d9ea53eb144b2871074c84aa28d9a1faa7923ad1547319bafe2e9968cc" ;; \
      arm64) asset_arch="aarch64"; \
        archive_sha256="8a7582e98501f414fee1ab691d44fb56ce59db01f21cbd521a414cb358b66394"; \
        executable_sha256="19198e8eac7a55db0c219d376bb801b0b954ad823c3ea3e445042b4c80fde124" ;; \
      *) echo "unsupported official CPA v8 target: $TARGETOS/$TARGETARCH (no v7 fallback)" >&2; exit 1 ;; \
    esac; \
    asset_name="CLIProxyAPI_8.0.45_linux_${asset_arch}.tar.gz"; \
    apk add --no-cache ca-certificates wget; \
    wget -qO "/tmp/${asset_name}" "https://github.com/router-for-me/CLIProxyAPI/releases/download/v8.0.45/${asset_name}"; \
    printf '%s  %s\n' "$archive_sha256" "/tmp/${asset_name}" | sha256sum -c -; \
    mkdir -p /out; \
    tar -xOzf "/tmp/${asset_name}" cli-proxy-api > /out/cli-proxy-api; \
    printf '%s  %s\n' "$executable_sha256" /out/cli-proxy-api | sha256sum -c -; \
    tar -xOzf "/tmp/${asset_name}" LICENSE > /out/CPA-LICENSE; \
    test -s /out/CPA-LICENSE; \
    chmod 0755 /out/cli-proxy-api; \
    printf '{"schemaVersion":1,"engine":"cpa","version":"8.0.45","artifactId":"sha256:%s"}\n' \
      "$executable_sha256" > /out/cpa-artifact.json; \
    chmod 0444 /out/cpa-artifact.json /out/CPA-LICENSE

FROM --platform=$BUILDPLATFORM golang:1.24-alpine AS supervisor-build

ARG TARGETOS
ARG TARGETARCH
WORKDIR /src/apps/runtime-supervisor
COPY apps/runtime-supervisor/go.mod apps/runtime-supervisor/go.sum ./
RUN go mod download
COPY apps/runtime-supervisor ./
RUN test "$TARGETOS" = "linux"
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -trimpath -ldflags="-s -w" -o /out/cpamp-runtime-supervisor ./cmd/cpamp-runtime-supervisor

FROM debian:bookworm-slim AS runtime-base

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tzdata \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 --system cpamp-cpa \
    && useradd --uid 10001 --gid 10001 --system --no-create-home \
      --home-dir /runtime/gateway --shell /usr/sbin/nologin cpamp-cpa
COPY --from=supervisor-build /out/cpamp-runtime-supervisor /usr/local/bin/cpamp-runtime-supervisor
COPY LICENSE /usr/local/share/licenses/cpamp/LICENSE
COPY bin/release/embedded-third-party-inventory.txt /usr/local/share/cpamp/release/third-party-inventory.txt
COPY docker/runtime/entrypoint.sh /usr/local/bin/cpamp-runtime-entrypoint

ENV CPAMP_RUNTIME_ADDR=0.0.0.0:9081 \
    CPAMP_RUNTIME_IDENTITY=embedded-default \
    CPAMP_RUNTIME_JOURNAL_PATH=/runtime/supervisor/operations.sqlite \
    CPAMP_RUNTIME_CPA_ADDR=127.0.0.1:8317 \
    CPAMP_RUNTIME_CPA_UID=10001 \
    CPAMP_RUNTIME_CPA_GID=10001 \
    CPAMP_CPA_EXECUTABLE=/usr/local/bin/cli-proxy-api \
    CPAMP_CPA_ARTIFACT_MANIFEST=/usr/local/share/cpamp/runtime/cpa-artifact.json

EXPOSE 8317 9081
ENTRYPOINT ["/usr/local/bin/cpamp-runtime-entrypoint"]
CMD ["/usr/local/bin/cpamp-runtime-supervisor"]

# Build with --platform linux/amd64 --target v8-amd64-candidate.
# Preserve the independently selected private candidate and seed.
FROM runtime-base AS v8-amd64-candidate
ARG TARGETARCH
RUN test "$TARGETARCH" = "amd64"
COPY --from=cpa-v8-download /out/cli-proxy-api /usr/local/bin/cli-proxy-api
COPY --from=cpa-v8-download /out/cpa-artifact.json /usr/local/share/cpamp/runtime/cpa-artifact.json
COPY --from=cpa-v8-download /out/CPA-LICENSE /usr/local/share/licenses/cli-proxy-api/LICENSE
COPY docker/runtime/config.v8.seed.yaml /usr/local/share/cpamp/runtime/config.seed.yaml

# Private Embedded Fresh network-isolation experiment; this is not a release target.
# CPA binds loopback and the companion Ingress shares its network namespace.
FROM runtime-base AS v8-amd64-loopback-proof
ARG TARGETARCH
RUN test "$TARGETARCH" = "amd64"
COPY --from=cpa-v8-download /out/cli-proxy-api /usr/local/bin/cli-proxy-api
COPY --from=cpa-v8-download /out/cpa-artifact.json /usr/local/share/cpamp/runtime/cpa-artifact.json
COPY --from=cpa-v8-download /out/CPA-LICENSE /usr/local/share/licenses/cli-proxy-api/LICENSE
COPY docker/runtime/config.v8.loopback-proof.yaml /usr/local/share/cpamp/runtime/config.seed.yaml

# Historical lifecycle regressions only; never selected by normal Compose.
FROM runtime-base AS v7-compatibility
COPY --from=cpa-download /out/cli-proxy-api /usr/local/bin/cli-proxy-api
COPY --from=cpa-download /out/cpa-artifact.json /usr/local/share/cpamp/runtime/cpa-artifact.json
COPY docker/runtime/config.seed.yaml /usr/local/share/cpamp/runtime/config.seed.yaml

# Normal v2 build: official CPA v8, isolated bootstrap, no data migration.
FROM runtime-base AS runtime
COPY --from=cpa-v8-download /out/cli-proxy-api /usr/local/bin/cli-proxy-api
COPY --from=cpa-v8-download /out/cpa-artifact.json /usr/local/share/cpamp/runtime/cpa-artifact.json
COPY --from=cpa-v8-download /out/CPA-LICENSE /usr/local/share/licenses/cli-proxy-api/LICENSE
COPY docker/runtime/config.v8.default.seed.yaml /usr/local/share/cpamp/runtime/config.seed.yaml
COPY docker/runtime/v8-entrypoint.sh /usr/local/bin/cpamp-runtime-v8-entrypoint
ENTRYPOINT ["/usr/local/bin/cpamp-runtime-v8-entrypoint"]
CMD ["/usr/local/bin/cpamp-runtime-supervisor"]
