FROM --platform=$BUILDPLATFORM golang:1.24-alpine AS ingress-build

ARG TARGETOS
ARG TARGETARCH
ARG CPAMP_PAH_S0_BUILD=0
WORKDIR /src/apps/ingress
COPY apps/ingress/go.mod ./
COPY apps/ingress ./
RUN test "$TARGETOS" = "linux"
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -trimpath -ldflags="-s -w -X main.pahS0Binary=$CPAMP_PAH_S0_BUILD" -o /out/cpamp-ingress ./cmd/cpamp-ingress

FROM alpine:3.21
RUN apk add --no-cache ca-certificates tzdata \
    && addgroup -S cpamp \
    && adduser -S -G cpamp -H cpamp
COPY --from=ingress-build /out/cpamp-ingress /usr/local/bin/cpamp-ingress
COPY LICENSE /usr/local/share/licenses/cpamp/LICENSE
COPY bin/release/embedded-third-party-inventory.txt /usr/local/share/cpamp/release/third-party-inventory.txt
COPY bin/release/embedded-third-party-notices.txt /usr/local/share/cpamp/release/third-party-notices.txt
COPY bin/release/embedded-third-party-notices.sources.json /usr/local/share/cpamp/release/third-party-notices.sources.json
USER cpamp:cpamp
EXPOSE 18317
ENTRYPOINT ["/usr/local/bin/cpamp-ingress"]
